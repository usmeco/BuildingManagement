# Copy to .env and fill in. Never commit .env
DATABASE_URL=sqlite:///./buildingmate.db
ADMIN_API_KEY=change-me-to-a-long-random-string
DEFAULT_MONTHLY_AMOUNT=1000
EVIDENCE_DIR=./evidence
REPORTS_DIR=./reports

# Screenshot (UPI) extraction via Claude API - optional until Phase 3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp Cloud API (Meta) - optional until Phase 2
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_APP_SECRET=
# Comma-separated phone numbers (country code, no +) allowed to submit payments besides registered flats
ADMIN_PHONES=

# Reminders: keep false until you have approved WhatsApp templates
REMINDERS_ENABLED=false
REMINDER_TEMPLATE_NAME=maintenance_reminder
